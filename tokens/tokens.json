    "caption": { "size": 11, "weight": 500, "lineHeight": 1.35 },
    "body-sm": { "size": 12, "weight": 400, "lineHeight": 1.45 },
    "body": { "size": 13, "weight": 400, "lineHeight": 1.45 },
    "title-sm": { "size": 14, "weight": 600, "lineHeight": 1.4 },
    "title": { "size": 16, "weight": 650, "lineHeight": 1.35 },
    "view-title": { "size": 20, "weight": 650, "lineHeight": 1.25 },
    "drill-header": { "size": 24, "weight": 700, "lineHeight": 1.2 }
  },
  "font": {
    "ui": ["Inter Variable", "Segoe UI Variable", "Segoe UI", "system-ui", "sans-serif"],
    "mono": ["JetBrains Mono", "Consolas", "monospace"]
  },
  "radius": {
    "control": 6,
    "box": 8,
    "popover": 12,
    "pill": 999
  },
  "shadow": {
    "dark": {
      "l1": "0 1px 2px rgba(0,0,0,0.18)",
      "l2": "0 4px 12px rgba(0,0,0,0.25)",
      "l3": "0 12px 32px rgba(0,0,0,0.35)"
    },
    "light": {
      "l1": "0 1px 2px rgba(0,0,0,0.08)",
      "l2": "0 4px 12px rgba(0,0,0,0.12)",
      "l3": "0 12px 32px rgba(0,0,0,0.18)"
    }
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "drill": "200ms",
    "tooltipDelay": "500ms",
    "ease": "cubic-bezier(0.22,1,0.36,1)"
  },
  "edge": {
    "stroke": 1.5,
    "strokeHi": 2,
    "cornerRadius": 8,
    "labelMaxWidth": 140,
    "labelZoomThreshold": 0.6,
    "portSize": 10,
    "framePadding": 30,
    "arrowMin": 8,
    "fanStep": 24
  },
