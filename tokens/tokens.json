  "layout": {
    "toolbarHeight": 40,
    "sidePanelWidth": 300,
    "sidePanelMin": 260,
    "sidePanelMax": 420,
    "leftBarWidth": 44,
    "toolHit": 32,
    "toolGlyph": 20,
    "statusBarHeight": 28,
    "canvasPadding": 24,
    "boxS": 120,
    "boxWideW": 220,
    "boxWideH": 110,
    "cell": 180,
    "gap": 60,
    "gapLabelRow": 120,
    "framePad": 30,
    "frameHeader": 72,
    "ctxChildS": 96,
    "ctxGap": 24,
    "ctxPad": 20,
    "ctxHeader": 44,
    "ctxTrayGap": 60
