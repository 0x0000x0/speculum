{
  "$schema": "https://speculum.local/schemas/tokens.v1.json",
  "meta": {
    "name": "Speculum design tokens",
    "version": "1.0.0",
    "notes": [
      "Single source of truth for M3. tools/gen-tokens.mjs generates CSS + Rust from this file.",
      "ACCENT ADJUSTMENT (contrast): spec draft listed accent.primary #5B8CFF (dark) / #2F6BFF (light) with white accent.on. Measured WCAG ratios: dark 3.16:1 (fails 4.5), light 4.50:1 (borderline). Darkened slightly for AA: dark #5B8CFF -> #3B69FF (4.52:1), light #2F6BFF -> #2B64F5 (4.95:1). Same blue hue family, noted per milestone instructions."
    ]
  },
  "color": {
    "dark": {
      "bg.chrome": "#0E1116",
      "bg.canvas": "#131720",
      "bg.canvas-dot": "#3B4A63",
      "bg.raised": "#1A212E",
      "bg.hover": "rgba(255,255,255,0.06)",
      "border.subtle": "#2A3344",
      "border.strong": "#3D4A61",
      "text.primary": "#F3F5F9",
      "text.secondary": "#A9B4C7",
      "text.tertiary": "#6B768C",
      "accent.primary": "#3B69FF",
      "accent.on": "#FFFFFF",
      "accent.secondary": "#8B5CF6",
      "state.success": "#34D399",
      "state.warning": "#FBBF24",
      "state.danger": "#F87171",
      "state.info": "#60A5FA",
      "focus.ring": "#3B69FF",
      "selection.fill": "rgba(59,105,255,0.12)"
    },
    "light": {
      "bg.chrome": "#F7F7F8",
      "bg.canvas": "#FFFFFF",
      "bg.canvas-dot": "#C9D0DB",
      "bg.raised": "#FFFFFF",
      "bg.hover": "rgba(17,24,39,0.05)",
      "border.subtle": "#E5E7EB",
      "border.strong": "#CBD2DC",
      "text.primary": "#111827",
      "text.secondary": "#4B5563",
      "text.tertiary": "#6B7280",
      "accent.primary": "#2B64F5",
      "accent.on": "#FFFFFF",
      "accent.secondary": "#7C3AED",
      "state.success": "#047857",
      "state.warning": "#B45309",
      "state.danger": "#DC2626",
      "state.info": "#1D4ED8",
      "focus.ring": "#2B64F5",
      "selection.fill": "rgba(43,100,245,0.12)"
    },
    "dim": {
      "unrelatedOpacity": 0.28
    }
  },
  "spacing": {
    "space.0_5": 2,
    "space.1": 4,
    "space.2": 8,
    "space.3": 12,
    "space.4": 16,
    "space.5": 20,
    "space.6": 24,
    "space.8": 32,
    "space.10": 40,
    "space.12": 48,
    "space.16": 64
  },
  "layout": {
    "toolbarHeight": 40,
    "sidePanelWidth": 300,
    "sidePanelMin": 260,
    "sidePanelMax": 420,
    "statusBarHeight": 28,
    "canvasPadding": 24
  },
  "type": {
    "caption": { "size": 11, "weight": 500, "lineHeight": 1.35 },
    "body-sm": { "size": 12, "weight": 400, "lineHeight": 1.45 },
    "body": { "size": 13, "weight": 400, "lineHeight": 1.45 },
    "title-sm": { "size": 14, "weight": 600, "lineHeight": 1.4 },
    "title": { "size": 16, "weight": 650, "lineHeight": 1.35 },
    "view-title": { "size": 20, "weight": 650, "lineHeight": 1.25 },
    "drill-header": { "size": 24, "weight": 700, "lineHeight": 1.2 }
  },
  "font": {
    "ui": ["Inter Variable", "Segoe UI Variable", "Segoe UI", "system-ui", "sans-serif"],
    "mono": ["JetBrains Mono", "Consolas", "monospace"]
  },
  "radius": {
    "control": 6,
    "box": 8,
    "popover": 12,
    "pill": 999
  },
  "shadow": {
    "dark": {
      "l1": "0 1px 2px rgba(0,0,0,0.18)",
      "l2": "0 4px 12px rgba(0,0,0,0.25)",
      "l3": "0 12px 32px rgba(0,0,0,0.35)"
    },
    "light": {
      "l1": "0 1px 2px rgba(0,0,0,0.08)",
      "l2": "0 4px 12px rgba(0,0,0,0.12)",
      "l3": "0 12px 32px rgba(0,0,0,0.18)"
    }
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "drill": "240ms",
    "tooltipDelay": "500ms",
    "ease": "cubic-bezier(0.22,1,0.36,1)"
  },
  "tags": {
    "slate": {
      "light": { "bg": "#F1F5F9", "fg": "#1E293B" },
      "dark": { "bg": "rgba(100,116,139,0.20)", "fg": "#CBD5E1", "border": "rgba(100,116,139,0.35)" }
    },
    "blue": {
      "light": { "bg": "#DBEAFE", "fg": "#1E40AF" },
      "dark": { "bg": "rgba(59,130,246,0.20)", "fg": "#BFDBFE", "border": "rgba(59,130,246,0.35)" }
    },
    "violet": {
      "light": { "bg": "#EDE9FE", "fg": "#5B21B6" },
      "dark": { "bg": "rgba(139,92,246,0.20)", "fg": "#DDD6FE", "border": "rgba(139,92,246,0.35)" }
    },
    "purple": {
      "light": { "bg": "#F3E8FF", "fg": "#6B21A8" },
      "dark": { "bg": "rgba(168,85,247,0.20)", "fg": "#E9D5FF", "border": "rgba(168,85,247,0.35)" }
    },
    "pink": {
      "light": { "bg": "#FCE7F3", "fg": "#9D174D" },
      "dark": { "bg": "rgba(236,72,153,0.20)", "fg": "#FBCFE8", "border": "rgba(236,72,153,0.35)" }
    },
    "red": {
      "light": { "bg": "#FEE2E2", "fg": "#991B1B" },
      "dark": { "bg": "rgba(239,68,68,0.20)", "fg": "#FECACA", "border": "rgba(239,68,68,0.35)" }
    },
    "orange": {
      "light": { "bg": "#FFEDD5", "fg": "#9A3412" },
      "dark": { "bg": "rgba(249,115,22,0.20)", "fg": "#FED7AA", "border": "rgba(249,115,22,0.35)" }
    },
    "amber": {
      "light": { "bg": "#FEF3C7", "fg": "#92400E" },
      "dark": { "bg": "rgba(245,158,11,0.20)", "fg": "#FDE68A", "border": "rgba(245,158,11,0.35)" }
    },
    "lime": {
      "light": { "bg": "#ECFCCB", "fg": "#3F6212" },
      "dark": { "bg": "rgba(132,204,22,0.20)", "fg": "#D9F99D", "border": "rgba(132,204,22,0.35)" }
    },
    "green": {
      "light": { "bg": "#DCFCE7", "fg": "#166534" },
      "dark": { "bg": "rgba(34,197,94,0.20)", "fg": "#BBF7D0", "border": "rgba(34,197,94,0.35)" }
    },
    "teal": {
      "light": { "bg": "#CCFBF1", "fg": "#115E59" },
      "dark": { "bg": "rgba(20,184,166,0.20)", "fg": "#99F6E4", "border": "rgba(20,184,166,0.35)" }
    },
    "cyan": {
      "light": { "bg": "#CFFAFE", "fg": "#155E75" },
      "dark": { "bg": "rgba(6,182,212,0.20)", "fg": "#A5F3FC", "border": "rgba(6,182,212,0.35)" }
    }
  }
}
